# Mesencsi E2E — másold .env néven az e2e/ mappába (opcionális; alapértelmezések alább).

E2E_BASE_URL=http://127.0.0.1:8000
E2E_API_URL=http://127.0.0.1:8000

# Shop user (global-setup regisztrál + verify script)
E2E_USER_EMAIL=e2e-buyer@example.com
E2E_USER_PASSWORD=E2eTest1234!

# Admin — egyezzen a backend .env OWNER_* értékekkel (OWNER_USERNAME automatikusan olvasva)
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=

# Szerver indítás Playwright-ból (false = te indítod run.bat / uvicorn)
E2E_START_SERVER=false

# Trace / video (CI-ben ajánlott: on-first-retry)
E2E_TRACE=on-first-retry
E2E_VIDEO=off
