# Copy to `.env` in this folder. `.env` is gitignored — keep secrets only there.
# Load order: `.env` then optional `.env.py` (same KEY=value syntax).

# =============================================================================
# Éles vs fejlesztői viselkedés
# =============================================================================
# MESENCSI_PRODUCTION=true → Barion stub (POSKey nélküli preview) tiltva; POST /payments/barion/callback tiltva,
# kivéve ha a kérés X-Internal-Debug fejléce byte-onként megegyezik MESENCSI_INTERNAL_DEBUG_SECRET-tel (hossz is egyezzen).
MESENCSI_PRODUCTION=
# MESENCSI_INTERNAL_DEBUG_SECRET=  (csak ha muszáj vész-helyreállítás; élesben alapból üres)

# Dev logging (not Django DEBUG): DEBUG | INFO | WARNING
LOG_LEVEL=INFO
# Optional alias: MESENCSI_LOG_LEVEL=DEBUG
# ENVIRONMENT=development  (shown in GET /health)

# =============================================================================
# BARION — a fizetéshez kapcsolódó env változók elsődlegesen ``BARION_*`` néven.
# Sandbox vs éles: ``BARION_ENV`` (ha üres, régi ``BARION_SANDBOX=true/false`` is működik).
# Dokumentáció: https://docs.barion.com/Payment-Start-v2
# =============================================================================
BARION_ENV=sandbox
# Éles Barion API + gateway: BARION_ENV=production  (vagy: prod | live | release)
# Régi alias (csak ha BARION_ENV üres): BARION_SANDBOX=true

BARION_POS_KEY=
BARION_PAYEE_EMAIL=

# Publikus API / gateway felülírás (ritka — alapból BARION_ENV választ test vs prod hostot):
# BARION_API_BASE_URL=https://api.test.barion.com
# BARION_GATEWAY_URL=https://secure.test.barion.com/Pay

# Return / IPN / cancel URL-ek (teljes https URL). Ha üres, a szerver a BARION_BACKEND_PUBLIC_URL alapján építi fel.
BARION_BACKEND_PUBLIC_URL=http://127.0.0.1:8000
BARION_RETURN_URL=
BARION_CALLBACK_URL=
# Alias a callbackhez: BARION_IPN_URL=  (ugyanaz, mint BARION_CALLBACK_URL)
# IPN hitelesítés (Barion Callback POST nem aláírt — lásd docs.barion.com/Callback_mechanism): ha be van állítva,
# a /payments/barion/ipn csak akkor dolgoz, ha a titok a CallbackUrl ``barion_ipn`` query részeként jön vissza
# (a Payment/Start ezt automatikusan hozzáfűzi) vagy X-Barion-Ipn-Secret / Authorization: Bearer egyezik.
# MESENCSI_PRODUCTION=true mellett kötelező (titok nélkül 403).
BARION_IPN_SECRET=
BARION_CANCEL_URL=

# A vásárló böngészőjének végső redirectje (bolt) — siker/hiba query után. Ha üres: PUBLIC_SITE_URL / FRONTEND_BASE_URL.
BARION_FRONTEND_LANDING_URL=

BARION_PAYMENT_WINDOW=01:00:00
BARION_LOCALE=hu-HU
BARION_CURRENCY=HUF

# Üres BARION_POS_KEY = stub (preview-… id, nincs külső Barion API). Élesben kötelező a POSKey.
# Stub „live” ág ellenőrzéshez (ritka): BARION_POS_ID=

# =============================================================================
# Admin JWT — POST /admin/login (külön a shop USER_JWT_SECRET-től)
# =============================================================================
# Min 32 chars, not "replace_with...". Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=
# ADMIN_JWT_EXPIRE_HOURS=12
# ADMIN_JWT_EXPIRE_MINUTES=  (ha megadva, felülírja az órát)
# ADMIN_JWT_ALGORITHM=HS256

# =============================================================================
# Admin / karbantartó — POST /admin/login
# =============================================================================
# Set your own login — helper script:
#   python scripts/setup_admin_credentials.py --owner-username YOUR_NAME --owner-password "YourPassword"
OWNER_USERNAME=owner
OWNER_PASSWORD=$2b$12$RODq4o.6S.4O74wOv/X7W.gqFb8wAVlN5cULfb65eyD8fG4K5RBNm
MAINTENANCE_USERNAME=maint
MAINTENANCE_PASSWORD=$2b$12$xDHw3z3hPjTAeFUT/RTi..goxZeQ4PwmIaBHzfrUTS3abkv8S5vG6

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=mesencsi
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mesencsi

# Optional: long random secret. GET /internal/incidents: header X-Incidents-Token
INCIDENTS_READ_TOKEN=

# =============================================================================
# CORS (production: kötelező, nincs wildcard / localhost)
# =============================================================================
# Elsődleges név; alias: ALLOWED_ORIGINS (vesszővel elválasztva)
# CORS_ALLOWED_ORIGINS=https://your-domain.hu,https://www.your-domain.hu

# =============================================================================
# Shop user JWT
# =============================================================================
USER_JWT_SECRET=replace_with_secure_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=
USER_JWT_EXPIRE_DAYS=7

# =============================================================================
# SMTP + public URLs (confirmation + order emails; Barion URLs use BARION_* above)
# Required on Render / staging / production (RENDER=true or ENVIRONMENT=staging|production).
# Local dev without SMTP: verification links are logged instead of sent.
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@your-domain.hu
# Render: set these in the service Environment tab (never commit real values here).
# ENVIRONMENT=staging
# RENDER=true  (set automatically on Render.com — triggers hosted SMTP requirements)
# Opcionális szöveg a sikeres fizetés visszaigazoló levelében (feldolgozás / szállítás):
# ORDER_CONFIRMATION_PROCESSING_NOTE=Feldolgozás: 1–3 munkanap. Szállítás: a megadott címre.
FRONTEND_BASE_URL=http://127.0.0.1:8000
PUBLIC_SITE_URL=http://127.0.0.1:8000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# Optional staging QA shop account (hosted only): pre-verified AppUser for checkout/Barion tests.
# QA_SHOP_EMAIL=qa-shop@your-staging-domain.hu
# QA_SHOP_PASSWORD=  (plain or bcrypt — same helpers as OWNER_PASSWORD)

# Then (from this folder):
#   docker compose up -d
#   run.bat
#   .venv\Scripts\python.exe -m alembic upgrade head
#
# run.bat creates .venv and runs uvicorn with that Python so you do not mix interpreters.
# If you skip run.bat, use:  python -m pip install -r requirements.txt
#                           python -m uvicorn mesencsi:app --reload
